    function presetName(presetId) {
        switch (presetId) {
        case "flat": return qsTr("Flat")
        case "rock": return qsTr("Rock")
        case "pop": return qsTr("Pop")
        case "jazz": return qsTr("Jazz")
        case "dance": return qsTr("Dance")
        case "edm": return qsTr("EDM")
        case "r-and-b": return qsTr("R&B / Hip-Hop")
        case "acoustic": return qsTr("Acoustic")
        case "bright": return qsTr("Bright")
        case "excited": return qsTr("Excited")
        case "mellow": return qsTr("Mellow")
        case "relaxed": return qsTr("Relaxed")
        case "vocal": return qsTr("Vocal")
        case "treble": return qsTr("Treble Boost")
        case "bass": return qsTr("Bass Boost")
